<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Frequency Distribution Calculator"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- Input Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter data (comma or space separated):"
                android:textSize="14sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/inputEditText"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="e.g., 23, 45, 67, 34, 56, 78, 89"
                android:inputType="text"
                android:gravity="top"
                android:padding="8dp"
                android:background="@android:drawable/edit_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/calculateButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Calculate" />

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Clear" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="12sp"
                android:paddingTop="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Statistics Section (Compact) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Statistics"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/statsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Results Table (Takes Most Space) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/tableCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frequency Distribution Table"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <TableLayout
                        android:id="@+id/resultsTable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <!-- Header Row -->
                        <TableRow
                            android:background="@android:color/darker_gray"
                            android:padding="8dp">

                            <TextView
                                android:text="CI"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="70dp"
                                android:gravity="center" />

                            <TextView
                                android:text="CB"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="90dp"
                                android:gravity="center" />

                            <TextView
                                android:text="CM"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="60dp"
                                android:gravity="center" />

                            <TextView
                                android:text="f"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="50dp"
                                android:gravity="center" />

                            <TextView
                                android:text="&lt;cF"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="50dp"
                                android:gravity="center" />

                            <TextView
                                android:text="&gt;cF"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="50dp"
                                android:gravity="center" />

                            <TextView
                                android:text="rF%"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:minWidth="60dp"
                                android:gravity="center" />
                        </TableRow>
                    </TableLayout>
                </ScrollView>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
